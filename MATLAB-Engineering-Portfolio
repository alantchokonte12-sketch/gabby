%% ==================== TASK 1: GRID INFORMATION ====================
fprintf('=== TASK 1: GRID INFORMATION ===\n');
fprintf('**********************************************************************\n');
fprintf('*                    LONGITUDE: -171.875°                           *\n');
fprintf('*                    LATITUDE: 46.375°                              *\n');
