function [r1, r2] = phi3(a, b, c)
    D = discriminant(a, b, c);
    r1 = (-b + sqrt(D)) / (2*a);
    r2 = (-b - sqrt(D)) / (2*a);

    function D = discriminant(a, b, c)
        D = b^2 - 4*a*c;
    end
end


