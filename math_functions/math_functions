function d3 = det3by3(A)
    d2(1) = det2by2(A([2 3], [2 3]));
    d2(2) = det2by2(A([2 3], [1 3]));
    d2(3) = det2by2(A([2 3], [1 2]));
    
    d3 = A(1,1)*d2(1) - A(1,2)*d2(2) + A(1,3)*d2(3);
end

function d2 = det2by2(A)
    d2 = A(1,1)*A(2,2) - A(1,2)*A(2,1);
end

